# Shared secret between the coordinator and every campus node. CHANGE THIS for any non-local deployment.
FEDTRUST_TOKEN=change-me-to-a-long-random-string
# Optional: protect the coordinator web UI with HTTP Basic auth (username: anything, password: this value)
COORDINATOR_ADMIN_PASSWORD=
FEDTRUST_DB=instance/fedtrust.db
FEDTRUST_DATA_DIR=data
